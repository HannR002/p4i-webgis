# P4I WebGIS staging environment template
# Copy this file to .env.local and fill values from the staging services only.
# Never place production or client credentials in staging.

# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Provider selection (current supported provider)
DATABASE_PROVIDER=supabase
AUTH_PROVIDER=supabase

# Google Earth Engine (future integration only; credentials DO NOT enable execution)
# Phase 12: SDK is not installed. A separately reviewed secure adapter is required.
# The legacy endpoint is fail-closed pending commercial scope and governed job adapter.
GEE_PROJECT_ID=

# Configure exactly one service-account representation.
GEE_SERVICE_ACCOUNT_JSON=
GEE_SERVICE_ACCOUNT_JSON_BASE64=

# P4I soil asset (required for flood analysis)
GEE_SOIL_ASSET_ID=
GEE_SOIL_BAND=soil_class
GEE_SOIL_DATASET_VERSION=p4i-soil-unvalidated-v1

# DEM configuration (optional overrides; these match application defaults)
GEE_DEM_ASSET_ID=USGS/SRTMGL1_003
GEE_DEM_BAND=elevation
GEE_DEM_DATASET_VERSION=usgs-srtmgl1-003

# Local UI fixtures only. Requires NODE_ENV=development; ignored in production.
GIS_DEMO_MODE=false

# No paid AI provider is selected. DEMO requires GIS_DEMO_MODE + development.
# Any explicit unknown/real selection fails closed; no silent DEMO fallback.
AI_PROVIDER=disabled

# Phase 15: opt-in disposable LOCAL PostGIS/PostgREST only. Never an external database URL.
# Production refuses this capability regardless of these values. Supabase staging remains blocked.
VECTOR_STORAGE_MODE=disabled
VECTOR_STORAGE_LOCAL_ACK=
VECTOR_STORAGE_LOCAL_URL=

# Academic preview ONLY. All deployment gates require separate review/authorization.
# Keep false for normal development/production; never turn GIS_DEMO_MODE on in production.
P4I_ACADEMIC_PREVIEW=false
P4I_PREVIEW_ID=
# Active preview requires AI_PROVIDER=academic-demo, VECTOR_STORAGE_MODE=disabled,
# GEMINI_FREE_ENABLED=false, no live Supabase/GEE/Gemini/database credentials.
# Vercel system variables VERCEL, VERCEL_ENV, VERCEL_PROJECT_ID, VERCEL_URL
# must identify the approved p4i-webgis project and the preview target.
