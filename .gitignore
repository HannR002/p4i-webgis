# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# env files - secrets must never be committed
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*

# allow safe environment template
!.env.example

# credentials / private keys
*.pem
*.key
*.p12
*.pfx

service-account*.json
service_account*.json
credentials*.json
google-credentials*.json
gcp-service-account*.json

# Supabase CLI local state
.supabase/
supabase/.temp/

# OS
.DS_Store
Thumbs.db

# Local CI evidence
/.ci-results/
