  {
    "ghsa_id": "GHSA-vfj7-8cjw-p6xm",
    "cve_id": "CVE-2026-93687",
    "summary": "Withdrawn Advisory: braces vulnerable to stack-exhaustion denial of service through deeply nested patterns",
    "severity": "high",
    "withdrawn_at": "2026-10-23T12:53:02Z",
    "vulnerabilities": [
      {
        "package": {
          "ecosystem": "npm",
          "name": "braces"
        },
        "vulnerable_version_range": "<= 3.0.3",
        "first_patched_version": null,
        "vulnerable_functions": []
      }
    ],
    "html_url": "https://github.com/advisories/GHSA-vfj7-8cjw-p6xm",
    "description": "### Withdrawn Advisory\nThis advisory has been withdrawn because it's not a practically exploitable vulnerability. This link is maintained to preserve external references.\n\n### Original Description\nbraces through 3.0.3 contains a stack overflow vulnerability in the recursive AST walkers that lack depth guards. Attackers can supply deeply nested brace patterns under the character limit to exhaust the call stack and terminate the Node.js process with an uncaught RangeError."
  }
